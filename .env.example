# STRIX Phase 6B-3 Telegram gateway configuration
# Do not commit real values. TELEGRAM_BOT_TOKEN must be provided only via runtime environment.
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_RATE_LIMIT_PER_MINUTE=10

# STRIX Phase 6B-4 local LLM brain gateway configuration
STRIX_LLM_PROVIDER=openai_compatible
STRIX_LLM_BASE_URL=http://127.0.0.1:8080/v1
STRIX_LLM_MODEL=qwen3.6-35b-a3b-turboquant
STRIX_LLM_API_KEY=local
STRIX_LLM_TIMEOUT_SECONDS=120
STRIX_LLM_MAX_OUTPUT_TOKENS=2048
STRIX_LLM_TEMPERATURE=0.2
STRIX_LLM_ENABLED=false
